<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- ── Network permissions ──────────────────────────────────────────────
         INTERNET               : Required by NsdManager on API 31+ (Tiramisu)
                                  and for outbound QUIC file transfers.
         ACCESS_NETWORK_STATE   : Read network info before attempting transfers.
         CHANGE_NETWORK_STATE   : Required for mDNS service discovery setup.
         ACCESS_WIFI_STATE      : Check if Wi-Fi is available before scanning.
         CHANGE_WIFI_MULTICAST_STATE : Allows the Wi-Fi radio to receive mDNS
                                  multicast packets (otherwise filtered by HW).
    ──────────────────────────────────────────────────────────────────────── -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.CHANGE_NETWORK_STATE" />
    <uses-permission android:name="android.permission.ACCESS_WIFI_STATE" />
    <uses-permission android:name="android.permission.CHANGE_WIFI_MULTICAST_STATE" />

    <!-- ── Staying reachable (X5, tracking M4) ──────────────────────────────
         FOREGROUND_SERVICE / _DATA_SYNC : ReceiverService keeps the QUIC
                                  listener and the LAN announcement alive while
                                  no screen is open. Without it the phone stops
                                  receiving the moment the activity is
                                  destroyed. DATA_SYNC is the type Android 14+
                                  requires to be declared for this shape of
                                  work.
         POST_NOTIFICATIONS     : the service's own notice, and the accept /
                                  decline choice for an inbound transfer. A
                                  refusal here does not stop the service; it
                                  costs the offer prompt while the app is
                                  backgrounded.
    ──────────────────────────────────────────────────────────────────────── -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <application
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.OpenAir">
        <!-- The OpenAir 2.0 shell over the gomobile-bound Go core (X5). It is
             the only launcher entry now: the v1 TCP stack was removed, so
             there is no second stack to keep apart from this one. -->
        <activity
            android:name=".v2.V2Activity"
            android:exported="true"
            android:label="@string/app_name"
            android:theme="@style/Theme.OpenAir">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <!-- The listening half of the v2 core (X5). It is the Android
             counterpart of `openaird`: there is no IPC, because D-31 puts the
             same Go core in this process, so the "daemon" is a service here and
             the UI reads its state directly. -->
        <service
            android:name=".v2.ReceiverService"
            android:exported="false"
            android:foregroundServiceType="dataSync" />
    </application>

</manifest>