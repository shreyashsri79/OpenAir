<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- ── Network permissions ──────────────────────────────────────────────
         INTERNET               : Required by NsdManager on API 31+ (Tiramisu)
                                  and for outbound TCP file transfers.
         ACCESS_NETWORK_STATE   : Read network info before attempting transfers.
         CHANGE_NETWORK_STATE   : Required for mDNS service discovery setup.
         ACCESS_WIFI_STATE      : Check if Wi-Fi is available before scanning.
         CHANGE_WIFI_MULTICAST_STATE : Allows the Wi-Fi radio to receive mDNS
                                  multicast packets (otherwise filtered by HW).
    ──────────────────────────────────────────────────────────────────────── -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.CHANGE_NETWORK_STATE" />
    <uses-permission android:name="android.permission.ACCESS_WIFI_STATE" />
    <uses-permission android:name="android.permission.CHANGE_WIFI_MULTICAST_STATE" />

    <application
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.OpenAir">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:label="@string/app_name"
            android:theme="@style/Theme.OpenAir">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- The OpenAir 2.0 shell over the gomobile-bound Go core (X5).
             A separate launcher entry rather than a replacement: v1 speaks TCP
             on _openair._tcp and v2 speaks QUIC on _openair._udp, so the two
             cannot talk to each other and must not appear to. -->
        <activity
            android:name=".v2.V2Activity"
            android:exported="true"
            android:label="@string/app_name_v2"
            android:theme="@style/Theme.OpenAir">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>

</manifest>